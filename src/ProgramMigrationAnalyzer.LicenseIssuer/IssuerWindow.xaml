<Window x:Class="ProgramMigrationAnalyzer.LicenseIssuer.IssuerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="公司離線授權發證工具" Width="820" Height="790" MinWidth="720" MinHeight="650"
    WindowStartupLocation="CenterScreen" PreviewKeyDown="OnPreviewKeyDown">
    <Window.Resources>
        <Style TargetType="Button"><Setter Property="Padding" Value="12,6"/><Setter Property="Margin" Value="0,0,8,0"/></Style>
        <Style TargetType="PasswordBox"><Setter Property="Padding" Value="6"/><Setter Property="MaxLength" Value="256"/></Style>
        <Style TargetType="TextBox"><Setter Property="Padding" Value="6"/></Style>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="22">
        <TextBlock Text="公司離線授權發證工具" FontSize="24" FontWeight="SemiBold"/>
        <TextBlock Margin="0,8,0,18" TextWrapping="Wrap"
            Text="僅供公司保管金鑰、維護內部帳號並簽發授權使用。請分開保管私鑰、保護密碼與人員登入密碼。"/>
        <GroupBox Header="公司簽章金鑰" Padding="12">
            <StackPanel IsEnabled="{Binding CanEdit}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="私鑰保護密碼（載入只需此欄）" Margin="0,0,0,5"/><PasswordBox x:Name="ProtectionInput"/></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="確認保護密碼（產生新金鑰）" Margin="0,0,0,5"/><PasswordBox x:Name="ProtectionConfirmationInput"/></StackPanel>
                </Grid>
                <WrapPanel Margin="0,12,0,0">
                    <Button x:Name="GenerateButton" Content="產生並儲存新金鑰" Click="OnGenerate"/>
                    <Button Content="載入加密私鑰" Click="OnLoad"/>
                    <Button Content="匯出公鑰" Click="OnExportPublic"/>
                </WrapPanel>
                <TextBlock Text="公鑰指紋" Margin="0,12,0,4"/>
                <TextBlock Text="{Binding KeyId}" TextWrapping="Wrap" FontFamily="Consolas"/>
            </StackPanel>
        </GroupBox>
        <GroupBox Header="帳號清單" Padding="12" Margin="0,14,0,0">
            <StackPanel>
                <TextBlock Text="{Binding AuthorizationSummary}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <DataGrid x:Name="AccountsGrid" ItemsSource="{Binding Accounts}" AutoGenerateColumns="False" IsReadOnly="True"
                    CanUserAddRows="False" Height="135" SelectionMode="Single" SelectionChanged="OnAccountSelected">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="帳號" Binding="{Binding Username}" Width="*"/>
                        <DataGridTextColumn Header="顯示名稱" Binding="{Binding DisplayName}" Width="*"/>
                        <DataGridCheckBoxColumn Header="啟用" Binding="{Binding IsEnabled}" Width="70"/>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel IsEnabled="{Binding CanEdit}" Margin="0,10,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="操作" Margin="0,0,0,5"/>
                            <ComboBox x:Name="OperationInput" SelectedIndex="0" SelectionChanged="OnOperationChanged" Padding="5">
                                <ComboBoxItem Content="建立帳號"/><ComboBoxItem Content="重設密碼"/><ComboBoxItem Content="啟用帳號"/><ComboBoxItem Content="停用帳號"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="帳號" Margin="0,0,0,5"/><TextBox x:Name="UsernameInput" MaxLength="64"/></StackPanel>
                        <StackPanel Grid.Column="4"><TextBlock Text="顯示名稱" Margin="0,0,0,5"/><TextBox x:Name="DisplayNameInput" MaxLength="256"/></StackPanel>
                    </Grid>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="登入密碼" Margin="0,0,0,5"/><PasswordBox x:Name="PasswordInput"/></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="確認登入密碼" Margin="0,0,0,5"/><PasswordBox x:Name="ConfirmationInput"/></StackPanel>
                    </Grid>
                    <TextBlock Margin="0,6,0,10" Text="兩種密碼皆為 8～128 個字元，允許 @、!、#、空白及 Unicode。" TextWrapping="Wrap"/>
                    <WrapPanel>
                        <Button x:Name="SubmitButton" Content="更新帳號清單" Click="OnSubmit"/>
                        <Button Content="開啟既有授權 Key" Click="OnOpenAuthorization"/>
                        <Button Content="簽發／重新簽發 Key" Click="OnExportAuthorization"/>
                    </WrapPanel>
                </StackPanel>
            </StackPanel>
        </GroupBox>
        <TextBlock Text="{Binding StatusMessage}" Margin="0,14,0,10" TextWrapping="Wrap" Foreground="#1D4F78"/>
        <Button Content="關閉" HorizontalAlignment="Right" Margin="0" Click="OnClose"/>
    </StackPanel>
    </ScrollViewer>
</Window>
