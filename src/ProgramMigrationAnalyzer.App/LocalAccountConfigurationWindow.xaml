<Window x:Class="ProgramMigrationAnalyzer.App.LocalAccountConfigurationWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="本機帳號設定" Width="460" Height="590" MinWidth="420" MinHeight="430"
        WindowStartupLocation="CenterScreen" Background="#F3F6FA"
        FontFamily="Microsoft JhengHei UI, Segoe UI" PreviewKeyDown="OnPreviewKeyDown">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="MinHeight" Value="34" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="MinWidth" Value="84" />
        </Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="本機帳號設定" FontSize="24" FontWeight="SemiBold" Foreground="#17365D" />
                <TextBlock Text="程式移植分析儀 - C#、4GL" Foreground="#637083" Margin="0,6,0,18" />
                <TextBlock Text="操作" Margin="0,0,0,5" />
                <ComboBox x:Name="ModeInput" ItemsSource="{Binding ModeOptions}" DisplayMemberPath="Label"
                          SelectedValuePath="Mode" SelectedValue="{Binding Mode}" IsEnabled="{Binding CanEdit}"
                          MinHeight="34" Padding="8,4" AutomationProperties.Name="帳號操作" />
                <TextBlock Text="帳號" Margin="0,12,0,5" />
                <TextBox x:Name="UsernameInput" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding CanEdit}" MaxLength="64" AutomationProperties.Name="帳號" />
                <TextBlock Text="顯示名稱（建立或重設時必填）" Margin="0,12,0,5" />
                <TextBox x:Name="DisplayNameInput" Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding CanEditPassword}" AutomationProperties.Name="顯示名稱" />
                <TextBlock Text="密碼（8～128 個 Unicode 字元，允許符號與空白）" Margin="0,12,0,5" TextWrapping="Wrap" />
                <PasswordBox x:Name="PasswordInput" IsEnabled="{Binding CanEditPassword}" AutomationProperties.Name="密碼" />
                <TextBlock Text="再次輸入密碼" Margin="0,12,0,5" />
                <PasswordBox x:Name="ConfirmationInput" IsEnabled="{Binding CanEditPassword}" AutomationProperties.Name="確認密碼" />
                <TextBlock Text="{Binding StatusMessage}" Margin="0,16,0,12" TextWrapping="Wrap"
                           Foreground="#17365D" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="SubmitButton" Content="儲存設定" IsDefault="True" Click="OnSubmit"
                    IsEnabled="{Binding CanEdit}" Background="#2563EB" Foreground="White" BorderBrush="#2563EB" />
            <Button Content="關閉" Click="OnClose" Margin="10,0,0,0" Background="#F8FAFC" BorderBrush="#C8D7E8" />
        </StackPanel>
    </Grid>
</Window>
