<Window x:Class="ProgramMigrationAnalyzer.App.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="程式移植分析儀 - 登入"
        Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Background="{StaticResource CanvasBrush}">
    <Border Margin="24" Padding="24" Background="White" CornerRadius="10"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <StackPanel>
            <TextBlock Text="程式移植分析儀" FontSize="23" FontWeight="SemiBold" Foreground="#17365D" />
            <TextBlock Text="請輸入帳號與密碼" Margin="0,8,0,24" Foreground="{StaticResource MutedTextBrush}" />
            <Label Content="帳號" Target="{Binding ElementName=UsernameBox}" Padding="0,0,0,6" />
            <TextBox x:Name="UsernameBox" MaxLength="128" Height="36" Padding="8,6" TabIndex="0" />
            <Label Content="密碼" Target="{Binding ElementName=PasswordInput}" Margin="0,14,0,0" Padding="0,0,0,6" />
            <PasswordBox x:Name="PasswordInput" MaxLength="128" Height="36" Padding="8,6" TabIndex="1" />
            <TextBlock x:Name="ErrorText" Foreground="#B91C1C" TextWrapping="Wrap" MinHeight="40" Margin="0,12,0,8"
                       AutomationProperties.LiveSetting="Polite" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="LoginButton" Content="登入" IsDefault="True" TabIndex="2" MinWidth="90"
                        Style="{StaticResource PrimaryToolbarButtonStyle}" Click="Login_Click" />
                <Button x:Name="CancelButton" Content="取消" IsCancel="True" TabIndex="3" MinWidth="80"
                        Style="{StaticResource ToolbarButtonStyle}" Click="Cancel_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
